# Linear API key for fetching tickets
LINEAR_API_KEY=lin_api_xxxxx

# Server configuration
PORT=3001
HOST=0.0.0.0

# Gandalf: configure these as secrets on the same Railway service as the chart
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=high
# Router and low-complexity path (high path uses OPENAI_MODEL above)
OPENAI_ROUTER_MODEL=gpt-5.4-mini
OPENAI_LOW_MODEL=gpt-5.4-mini
OPENAI_LOW_REASONING_EFFORT=low
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
# Optional user token for channel thread history, if required by your Slack installation
SLACK_HISTORY_TOKEN=
# Restrict incoming events to your Slack workspace
SLACK_TEAM_ID=
GANDALF_TIMEZONE=America/New_York
GANTT_URL=https://my-gantt.pages.dev/
# Optional persistent directory for tickets.json (migrate existing data before changing)
# GANTT_DATA_DIR=/data

# Optional personal, read-only search and channel replies
GANDALF_SEARCH_OWNER=
SLACK_SEARCH_TOKEN=
GRANOLA_API_KEY=
# Allow normal channel messages to be considered for a response.
GANDALF_CHANNEL_REPLIES=false
# Allow the configured owner's Slack and Granola search in channels and other DMs.
GANDALF_CHANNEL_SEARCH=false
SLACK_BOT_USER_ID=

# Optional Pylon read-only API token (owner's DM only)
PYLON_API_TOKEN=

# Optional proactive guidance to the owner's verified direct conversation
GANDALF_PROACTIVE_ENABLED=false
GANDALF_PROACTIVE_DM_CHANNEL=
GANDALF_PROACTIVE_MIN_MESSAGE_MINUTES=60
