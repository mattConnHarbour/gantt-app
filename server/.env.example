# Linear API key for fetching tickets
LINEAR_API_KEY=lin_api_xxxxx

# Server configuration
PORT=3001
HOST=0.0.0.0

# Gandalf: configure these as secrets on the same Railway service as the chart
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=high
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
# Optional user token for channel thread history, if required by your Slack installation
SLACK_HISTORY_TOKEN=
# Restrict incoming events to your Slack workspace
SLACK_TEAM_ID=
GANDALF_TIMEZONE=America/New_York
GANTT_URL=https://my-gantt.pages.dev/
# Optional persistent directory for tickets.json (migrate existing data before changing)
# GANTT_DATA_DIR=/data

# Optional personal, read-only search; available only in this owner's DM
GANDALF_SEARCH_OWNER=
SLACK_SEARCH_TOKEN=
GRANOLA_API_KEY=
